<?xml version="1.0" encoding="UTF-8"?>
<simulation_settings>
    <general>
        <simulation_time>60</simulation_time>
        <warm_up_period>0</warm_up_period>
        <vm_load_check_interval>1</vm_load_check_interval>
        <location_check_interval>1</location_check_interval>
        <file_log_enabled>false</file_log_enabled>
        <deep_file_log_enabled>false</deep_file_log_enabled>
        <simulation_seed>42</simulation_seed>
    </general>
    <uav>
        <num_of_uavs>2</num_of_uavs>
        <uav_max_energy>10000</uav_max_energy>
        <uav_initial_height>50</uav_initial_height>
        <uav_flight_power>50</uav_flight_power>
        <uav_hover_power>20</uav_hover_power>
        <uav_compute_energy_per_mi>0.001</uav_compute_energy_per_mi>
    </uav>
    <simulation_space><x>1000</x><y>1000</y><z>200</z></simulation_space>
    <scenario><single_tier>true</single_tier><two_tier>false</two_tier><two_tier_with_EO>false</two_tier_with_EO></scenario>
    <orchestrator><random>true</random><ddpg>false</ddpg></orchestrator>
</simulation_settings>
